# Secret token clients send in the X-Api-key header.
# Generate one: openssl rand -hex 32
API_KEY=

# PostgreSQL connection string (required).
# With the bundled database (docker compose --profile db) keep the password
# in sync with POSTGRES_PASSWORD below.
DATABASE_URL=postgres://wol:change-me@127.0.0.1:5432/wol
POSTGRES_PASSWORD=change-me

# HTTP port (docker-compose reads HOST_PORT, the binary reads PORT).
HOST_PORT=8084
